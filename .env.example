# Copy to .env (docker compose) or .env.local (npm run dev). Never commit real values.
POSTGRES_USER=baf1
POSTGRES_PASSWORD=change-me
POSTGRES_DB=baf1
ANTHROPIC_API_KEY=
CLAUDE_MODEL_MAIN=claude-sonnet-5-5
CLAUDE_MODEL_FAST=claude-haiku-5-5
MIN_MATCHED_LAUNCHES=3
TOP_N_NEIGHBOURS=7
# A matching product field is used only when at least this share of past launches has a value (0 to 1)
MIN_FIELD_COVERAGE=0.3
# On first start, when the database is empty:
#   demo   = synthetic history + a demo launch (for presenting)
#   config = users, lines, parameters and rules only; then load your own history on the Import page
#   none   = do nothing
SEED_MODE=demo
DEMO_USER_SWITCHER=true
# Local dev only:
# DATABASE_URL=postgres://baf1:baf1@localhost:5433/baf1

# --- Microsoft Copilot (MCP) ---
# Leave MCP_API_KEY empty to switch the MCP endpoint off. Otherwise use a long random value (at least 16 characters).
# Copilot sends it as "Authorization: Bearer <key>" or "x-api-key: <key>".
MCP_API_KEY=
# Role of the "Copilot (MCP)" service account: viewer (read only), rd_engineer (can draft launches and ask for recommendations), process_engineer
MCP_SERVICE_ROLE=rd_engineer
# Public address of the app, used for the review links Copilot gives to people, for example https://launch.example.com
PUBLIC_BASE_URL=
MCP_RATE_LIMIT_PER_MIN=60
