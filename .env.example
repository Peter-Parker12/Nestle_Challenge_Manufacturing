# Copy to .env (docker compose) or .env.local (npm run dev). Never commit real values.
POSTGRES_USER=radar
POSTGRES_PASSWORD=change-me
POSTGRES_DB=radar
ANTHROPIC_API_KEY=
CLAUDE_MODEL_MAIN=claude-sonnet-5-5
CLAUDE_MODEL_FAST=claude-haiku-5-5
# On first start, when the database is empty:
#   demo   = synthetic, real-shaped market data with planted events (for presenting)
#   config = users, channels and settings only; then load your own prices and sales
#   none   = do nothing
SEED_MODE=demo
DEMO_USER_SWITCHER=true
# Local dev only:
# DATABASE_URL=postgres://radar:radar@localhost:5433/radar
